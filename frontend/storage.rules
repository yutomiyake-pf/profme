rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // アバター画像: 本人のみ書き込み可、誰でも読み取り可（公開プロフィール用）
    match /users/{uid}/avatar/{fileName} {
      allow read: if true;
      allow write:
        if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    // 名刺 QR の自動生成画像: サーバ (Admin SDK) のみ書き込み、誰でも読める
    match /users/{uid}/qr/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // 既定では拒否
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
